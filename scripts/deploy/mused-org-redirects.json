{
  "description": "Legacy guided sites to mused.com",
  "expression": "http.host in {\"giza.mused.org\" \"copan.mused.org\" \"stcatherines.mused.org\" \"luxortemple.mused.org\"}",
  "action": "redirect",
  "action_parameters": {
    "from_value": {
      "status_code": 301,
      "target_url": {
        "expression": "concat(\"https://mused.com\", http.request.uri.path)"
      },
      "preserve_query_string": true
    }
  },
  "enabled": true
}

{
  "name": "sphr-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "convert:legacy-splat": "node scripts/convert-legacy-splat.mjs",
    "import:matterport": "node scripts/matterport/import.mjs",
    "import:matterport-web": "node scripts/matterport/import-web.mjs",
    "test:matterport": "node scripts/matterport/test.mjs",
    "scenes:index": "python3 scripts/matterport/catalog.py",
    "scenes:publish": "python3 scripts/matterport/publish.py",
    "test:hosting": "node --test scripts/test-hosting.mjs && python3 -m unittest discover -s scripts/matterport -p test_publish.py -v",
    "test:admin": "node --test scripts/test-admin.mjs",
    "test:editor": "node --experimental-transform-types --test scripts/test-scene-editor.mjs",
    "test:navigation": "node --test scripts/test-navigation.mjs scripts/test-overview.mjs scripts/test-audio-autoplay.mjs && node --experimental-transform-types --test scripts/test-panorama-navigation.mjs scripts/test-viewer-session.mjs",
    "test:catalog": "python3 -m unittest discover -s scripts/matterport -p test_catalog.py -v",
    "test:accounts": "node --test scripts/test-accounts.mjs",
    "test:social": "node --test scripts/test-social.mjs",
    "test:accounts-routes": "node scripts/test-accounts-routes.mjs",
    "test:agents": "node scripts/test-agent-connector.mjs",
    "worker": "node scripts/worker/agent-runner.mjs",
    "test:experience": "node --experimental-transform-types --test scripts/test-experience.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@sparkjsdev/spark": "2.1.0",
    "3d-tiles-renderer": "^0.5.3",
    "draco3dgltf": "^1.5.7",
    "lucide-react": "1.23.0",
    "next": "16.2.10",
    "nodemailer": "10.0.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sharp": "0.34.5",
    "stripe": "22.6.2",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.0",
    "typescript": "^5.9.3"
  }
}
